# Copy to .env (never commit it) and fill in your own values.
# Not needed for the local stack (docker compose up): it uses a MongoDB container.

# MongoDB Atlas connection string, used by every service and by deploy-cinema-aws.sh
MONGODB_ATLAS_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Legacy replica-set credentials (only used without MONGODB_ATLAS_URI)
DB_USER=
DB_PASS=

# payment-service: Stripe API keys
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# notification-service: SMTP password
EMAIL_PASS=
